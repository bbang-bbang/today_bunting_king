# ==============================================================
# 내일은 번트왕 — 환경변수 템플릿
# 이 파일을 복사해서 .env 로 저장한 뒤 실제 값을 채우세요.
# .env 는 .gitignore 에 포함되어 있어 외부로 유출되지 않습니다.
# ==============================================================

# ==============================================================
# 실행 모드
# ==============================================================
# paper     : DB 시뮬레이션만 (외부 API 호출 없음, 개발/테스트용)
# kis_mock  : KIS 모의투자 API 호출 (실제 체결은 없으나 KIS 서버 실제 호출)
# live      : 실거래 (kis_mock에서 20영업일 무오류 후에만 권장)
TRADE_MODE=paper

# ==============================================================
# 활성 시드머니 (원)
# ==============================================================
# 절대 상한 SEED_CAP_KRW = 1,000,000 은 코드 상수로 고정 (불변).
# 이 환경변수는 "활성 시드" 로서 100만 이하 범위에서 자유롭게 조정 가능.
# - 소액 실전 테스트: 100000 (10만원)
# - 정상 운영:        1000000 (100만원)
# 100만 초과 입력 시 앱 시작 단계에서 에러로 거부됩니다.
SEED_KRW=1000000

# ==============================================================
# Telegram
# ==============================================================
# @BotFather에게 /newbot 으로 발급받은 토큰
TELEGRAM_BOT_TOKEN=

# /start <초대코드> 등록에 사용. 직접 정하세요 (예: BUNTING2026-XYZ)
TELEGRAM_INVITE_CODE=

# 장애/관리자 알림 수신용 chat_id (본인 Telegram 숫자 ID)
# @userinfobot 에게 아무 메시지 보내면 알려줍니다.
TELEGRAM_ADMIN_CHAT_ID=

# ==============================================================
# KIS Developers — 모의투자 (kis_mock 모드에서 사용)
# https://apiportal.koreainvestment.com 에서 신청
# ==============================================================
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
# 모의투자 계좌번호 형식: "50000000-01" (하이픈 포함, 앞 8자리-뒤 2자리)
KIS_MOCK_ACCOUNT_NO=

# ==============================================================
# KIS Developers — 실거래 (live 모드에서만 사용. 기본 공란 유지)
# ==============================================================
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=

# ==============================================================
# DB / 로그
# ==============================================================
DB_PATH=./data/bunting.db
LOG_LEVEL=INFO
LOG_PATH=./logs/bunting.log

# ==============================================================
# 운영 토글
# ==============================================================
# 평일 08:00 자동 추천 잡 등록 여부. false 면 잡 자체를 안 걸고
# /추천 수동 호출만 동작. (true|false, 기본 true)
AUTO_RECOMMEND_ENABLED=true

# 장중 주기적 잔고 동기화 간격(분). 0 = 비활성. (기본 0)
BALANCE_PERIODIC_MINUTES=0

# 브로커 잔고(KIS inquire-balance) 캐시 TTL(초). 같은 계좌 잔고를 N초 내 재요청하면
# 네트워크 콜 없이 캐시 반환 — 여러 잡/버튼의 동시·연속 호출을 단일 KIS 콜로 합쳐
# /잔고 체감 지연을 줄임. 매수·매도 직후 자동 무효화. 0 = 캐시 비활성. (기본 8)
BALANCE_CACHE_TTL_SEC=8

# ==============================================================
# 추천 / 시장 레짐
# ==============================================================
# 추천 최소 앙상블 점수 (0~100). 이 점수 미만 종목은 추천에서 제외. (기본 60)
RECOMMEND_MIN_SCORE=60

# 전일 코스피 등락률 하한선(%). 이 값 미만으로 급락하면 레짐 가드 발동.
# 0 으로 두면 레짐 필터 비활성화. (기본 -1.5)
MARKET_DOWN_THRESHOLD_PCT=-1.5

# --- 레짐 가드 발동 시 동작 (급변장 "단타 전환") ---
# true  : 추천을 통째 보류하지 않고 단타 전환(번트 only·점수 바 상향·시드 축소)으로 발송.
#         번트왕이 급변장에 침묵하지 않도록 — 최상위 셋업만 작은 사이즈로.
# false : 기존 동작(추천 보류 메시지만 발송). (기본 true)
REGIME_DEGRADED_ENABLED=true
# 단타 전환 모드 최소 점수 (평시 RECOMMEND_MIN_SCORE 보다 높게). (기본 70)
REGIME_DEGRADED_MIN_SCORE=70
# 단타 전환 모드 시드 투입 비율(%) — 포지션당 금액을 줄여 리스크 감축. 1~100. (기본 50)
REGIME_DEGRADED_SEED_PCT=50
